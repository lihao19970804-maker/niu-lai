# 牛来 (NiuLai) v0.1.0 requires no secrets for its bundled examples.
# Future providers should read credentials from the environment and never
# commit real values. Use clearly fake placeholders when documenting them.
VIGILMESH_LOG_LEVEL=INFO
VIGILMESH_WEBHOOK_URL=https://example.invalid/vigilmesh-webhook
VIGILMESH_PROVIDER_TOKEN=replace-with-a-local-secret
